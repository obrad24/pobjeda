@import "tailwindcss";

:root {
  --gold: #c89a32;
  --gold-light: #d8af4a;
  --gold-dark: #a8791f;
  --navy: #172b4d;
  --navy-dark: #0d1b2f;
  --red: #c62828;
  --red-dark: #991b1b;
  --white: #ffffff;
  --cream: #f7f4ea;
  --ink: #111827;
  --muted: #64748b;

  /* Liquid Glass tokens */
  --glass-blur-sm: 4px;
  --glass-blur-md: 12px;
  --glass-blur-lg: 24px;
  --glass-blur-xl: 40px;
  --glass-bg-light: rgba(255, 255, 255, 0.55);
  --glass-bg-dark: rgba(13, 27, 47, 0.65);
  --glass-bg-card: rgba(255, 255, 255, 0.12);
  --glass-border: rgba(255, 255, 255, 0.22);
  --glass-border-light: rgba(255, 255, 255, 0.35);
  --glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.1), 0 2px 8px rgba(0, 0, 0, 0.06);
  --glass-shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.14), 0 4px 16px rgba(0, 0, 0, 0.08);
  --glass-glow-gold: 0 0 40px rgba(200, 154, 50, 0.12);

  /* Purple / violet accent for player pages */
  --purple: #7c3aed;
  --purple-light: #a78bfa;
  --purple-dark: #5b21b6;
  --purple-glow: rgba(124, 58, 237, 0.25);
}

@theme inline {
  --color-gold: var(--gold);
  --color-gold-light: var(--gold-light);
  --color-gold-dark: var(--gold-dark);
  --color-navy: var(--navy);
  --color-navy-dark: var(--navy-dark);
  --color-red: var(--red);
  --color-red-dark: var(--red-dark);
  --color-cream: var(--cream);
  --color-ink: var(--ink);
  --color-muted: var(--muted);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
  --font-display: var(--font-barlow);
  --color-purple: var(--purple);
  --color-purple-light: var(--purple-light);
  --color-purple-dark: var(--purple-dark);
}

html {
  scroll-behavior: smooth;
}

body {
  background: linear-gradient(165deg, #0d1b2f 0%, #172b4d 40%, #1e3a5f 70%, #0d1b2f 100%);
  background-attachment: fixed;
  color: var(--white);
  font-family: var(--font-geist-sans), ui-sans-serif, system-ui, sans-serif;
  min-height: 100vh;
}

::selection {
  background: var(--gold);
  color: var(--navy-dark);
}

:focus-visible {
  outline: 2px solid var(--gold);
  outline-offset: 3px;
}

/* Liquid Glass utility classes */
.glass {
  background: var(--glass-bg-light);
  backdrop-filter: blur(var(--glass-blur-md)) saturate(1.4);
  -webkit-backdrop-filter: blur(var(--glass-blur-md)) saturate(1.4);
  border: 1px solid var(--glass-border);
  border-top-color: var(--glass-border-light);
  box-shadow: var(--glass-shadow);
}

.glass-dark {
  background: var(--glass-bg-dark);
  backdrop-filter: blur(var(--glass-blur-lg)) saturate(1.5);
  -webkit-backdrop-filter: blur(var(--glass-blur-lg)) saturate(1.5);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-top-color: var(--glass-border);
  box-shadow: var(--glass-shadow);
}

.glass-card {
  background: var(--glass-bg-card);
  backdrop-filter: blur(var(--glass-blur-md)) saturate(1.3);
  -webkit-backdrop-filter: blur(var(--glass-blur-md)) saturate(1.3);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-top-color: var(--glass-border);
  box-shadow: var(--glass-shadow);
  transition: background 0.2s, border-color 0.2s, box-shadow 0.2s;
}

.glass-card:hover {
  background: rgba(255, 255, 255, 0.18);
  border-color: rgba(200, 154, 50, 0.3);
  box-shadow: var(--glass-shadow-lg), var(--glass-glow-gold);
}

.glass-strong {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(var(--glass-blur-lg)) saturate(1.6);
  -webkit-backdrop-filter: blur(var(--glass-blur-lg)) saturate(1.6);
  border: 1px solid rgba(255, 255, 255, 0.5);
  box-shadow: var(--glass-shadow-lg);
}

.glass-pill {
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(var(--glass-blur-sm));
  -webkit-backdrop-filter: blur(var(--glass-blur-sm));
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 9999px;
}

/* Hero panel — glass over gradient */
.hero-panel {
  background: linear-gradient(180deg, rgba(13, 27, 47, 0.95) 0%, rgba(23, 43, 77, 0.9) 100%);
  position: relative;
  overflow: hidden;
}

.hero-panel::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 60% 50% at 50% 120%, rgba(200, 154, 50, 0.08), transparent),
    radial-gradient(ellipse 80% 40% at 20% 0%, rgba(23, 43, 77, 0.5), transparent);
  pointer-events: none;
}

.hero-panel::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(200, 154, 50, 0.4), transparent);
}

/* Ambient background glow spots */
.ambient-bg {
  position: relative;
}

.ambient-bg::before {
  content: "";
  position: fixed;
  top: -20%;
  right: -10%;
  width: 60%;
  height: 60%;
  background: radial-gradient(circle, rgba(200, 154, 50, 0.04) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

.ambient-bg::after {
  content: "";
  position: fixed;
  bottom: -20%;
  left: -10%;
  width: 50%;
  height: 50%;
  background: radial-gradient(circle, rgba(30, 58, 95, 0.3) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

@supports not (backdrop-filter: blur(1px)) {
  .glass { background: rgba(255, 255, 255, 0.85); }
  .glass-dark { background: rgba(13, 27, 47, 0.92); }
  .glass-card { background: rgba(255, 255, 255, 0.2); }
  .glass-strong { background: rgba(255, 255, 255, 0.9); }
}

.table-scroll {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.table-scroll table {
  min-width: 640px;
}

.table-scroll.standings-table {
  overflow-x: hidden;
}

.table-scroll.standings-table table {
  min-width: 0;
  width: 100%;
  table-layout: fixed;
}

.sticky-col {
  position: sticky;
  left: 0;
  z-index: 1;
}

.page-loader-bar-track {
  position: fixed;
  inset: 0 0 auto;
  z-index: 60;
  height: 3px;
  overflow: hidden;
  background: color-mix(in srgb, var(--gold) 25%, transparent);
}

.page-loader-bar {
  height: 100%;
  width: 35%;
  background: var(--gold);
  animation: page-loader-bar 1s ease-in-out infinite;
}

.page-loader-body {
  display: flex;
  min-height: 50vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  opacity: 0;
  animation: page-loader-fade 180ms ease forwards;
  animation-delay: 280ms;
}

.page-loader-spinner {
  width: 2.75rem;
  height: 2.75rem;
  border: 3px solid color-mix(in srgb, var(--gold) 22%, transparent);
  border-top-color: var(--gold);
  border-radius: 9999px;
  animation: page-loader-spin 0.7s linear infinite;
}

.page-loader-label {
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--muted);
}

@keyframes page-loader-bar {
  0% {
    transform: translateX(-120%);
  }
  100% {
    transform: translateX(380%);
  }
}

@keyframes page-loader-spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes page-loader-fade {
  to {
    opacity: 1;
  }
}

/* Player profile hero */
.player-hero-bg {
  background: linear-gradient(135deg, #1a0533 0%, #2d1065 30%, #5b21b6 60%, #7c3aed 100%);
  position: relative;
  overflow: hidden;
}

.player-hero-bg::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 60% at 70% 90%, rgba(124, 58, 237, 0.3), transparent),
    radial-gradient(ellipse 60% 40% at 10% 20%, rgba(91, 33, 182, 0.4), transparent);
  pointer-events: none;
}

.player-hero-bg::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(to top, rgba(13, 27, 47, 0.95), transparent);
  pointer-events: none;
}

/* Position filter pills */
.position-pill {
  padding: 0.5rem 1.25rem;
  border-radius: 9999px;
  font-size: 0.875rem;
  font-weight: 600;
  transition: all 0.2s;
  border: 1px solid transparent;
  color: rgba(255, 255, 255, 0.6);
  background: transparent;
}

.position-pill:hover {
  color: white;
  background: rgba(255, 255, 255, 0.08);
}

.position-pill-active {
  color: white;
  background: var(--purple);
  border-color: var(--purple-light);
  box-shadow: 0 0 20px var(--purple-glow);
}

/* Player list row */
.player-list-row {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.875rem 1rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  transition: background 0.15s;
}

.player-list-row:hover {
  background: rgba(124, 58, 237, 0.08);
}

.player-list-row:last-child {
  border-bottom: none;
}

/* Draft / action button purple */
.btn-purple {
  background: linear-gradient(135deg, var(--purple) 0%, var(--purple-dark) 100%);
  color: white;
  border-radius: 9999px;
  padding: 0.75rem 2rem;
  font-weight: 700;
  font-size: 1rem;
  transition: all 0.2s;
  border: none;
  box-shadow: 0 4px 20px var(--purple-glow);
}

.btn-purple:hover {
  box-shadow: 0 6px 30px rgba(124, 58, 237, 0.4);
  transform: translateY(-1px);
}
