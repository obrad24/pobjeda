# Neon PostgreSQL (pooled connection for the Next.js app)
# From Neon Console → Connect → pooled (hostname contains -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Neon PostgreSQL (direct / non-pooled connection for Prisma CLI migrations)
# From Neon Console → Connect → direct (hostname without -pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# SportDC league source
SPORTDC_LEAGUE_URL="https://sportdc.net/league/6452-prva-opstinska-liga-bijeljina"
SPORTDC_LEAGUE_ID="6452"

# Stable SportDC club ID for FK Pobjeda Triješnica
SPORTDC_CLUB_ID="8448"

# Protects GET /api/cron/sportdc-sync (Vercel Cron Authorization: Bearer ...)
CRON_SECRET=""

# Auth.js / NextAuth secret (generate with: openssl rand -base64 32)
AUTH_SECRET=""

# Optional public site URL for Auth.js (Vercel sets this automatically)
# AUTH_URL="http://localhost:3000"

# Vercel Blob — player photo uploads (optional; URL field still works without it)
BLOB_READ_WRITE_TOKEN=""

# Development seed only — never use these values in production
ADMIN_EMAIL="admin@pobjeda.local"
ADMIN_PASSWORD="pobjeda-dev"
